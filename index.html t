<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NebulaForge Handbook</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,wght@0,400;0,600;1,400&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #14151f;
    --bg-raised: #1b1c29;
    --ink: #c9cbd6;
    --ink-dim: #83869c;
    --rule: #2a2c3d;
    --link: #a889d8;
    --link-visited: #7d6aa8;
    --code: #d8a657;
    font-size: 17px;
  }
  :root[data-theme="light"] {
    --bg: #fbfaf6;
    --bg-raised: #f0eee6;
    --ink: #24242c;
    --ink-dim: #63637a;
    --rule: #d9d6cb;
    --link: #6f4fa3;
    --link-visited: #8a6bb8;
    --code: #93641c;
  }

  * { box-sizing: border-box; }

  body {
    background: var(--bg);
    color: var(--ink);
    font-family: 'Source Serif 4', Georgia, serif;
    line-height: 1.6;
    margin: 0;
  }

  a { color: var(--link); }
  a:visited { color: var(--link-visited); }

  code, pre {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
  }
  code {
    font-size: 0.85em;
    color: var(--code);
  }
  pre {
    background: var(--bg-raised);
    border: 1px solid var(--rule);
    padding: 0.9rem 1.1rem;
    overflow-x: auto;
    font-size: 0.82rem;
    line-height: 1.5;
  }
  pre code { color: var(--ink); }

  .navheader {
    border-bottom: 1px solid var(--rule);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    color: var(--ink-dim);
    padding: 0.6rem 1.5rem;
    display: flex;
    justify-content: space-between;
